# UPS Monitor v2 — secrets & tunables template
# cp .env.example .env  &&  chmod 600 .env
# .env is git-ignored. Deploy scripts source it and inject values at
# build/push time. Never commit real values, never put them in source.

# ── Telegram ─────────────────────────────────────────
TG_BOT_TOKEN=1234567890:AAExampleTokenReplaceMe000000000000
TG_CHAT_ID=123456789
TG_PROXY=                       # optional: socks5h://user:pass@host:port

# ── ntfy fallback (runs on the Pi itself — survives Proxmox shutdown) ──
NTFY_URL=http://192.168.0.169:2586
NTFY_TOPIC=ups

# ── Proxmox ──────────────────────────────────────────
PVE_TOKEN=PVEAPIToken=root@pam!esp32=00000000-0000-0000-0000-000000000000
PROXMOX_IP=192.168.0.50
PROXMOX_NODE=prox
PROXMOX_SHUTDOWN_URL=http://192.168.0.50:9999/shutdown

# ── Hosts / deploy targets ───────────────────────────
PI_SSH=pi@192.168.0.169         # deploy-pi.sh target
PI_PASS=                        # used via sshpass (deploy auth)
ESP32_IP=192.168.0.178

# ── Firmware → Pi fast-path (compiled into firmware) ──
PI_NOTIFY_URL=http://192.168.0.169:9997/notify
NOTIFY_TOKEN=                   # shared webhook auth — long random string

# ── WiFi (compiled into firmware) ────────────────────
WIFI_SSID=YourWifi
WIFI_PASS=YourWifiPassword
WIFI_BSSID_BYTES={0xDE,0xAD,0xBE,0xEF,0x00,0x11}
OTA_PASSWORD=change-me

# ── Wake-on-LAN ──────────────────────────────────────
MAC=00:11:22:33:44:55           # Proxmox node NIC
WOL_BROADCAST=192.168.0.255

# ── Timing defaults (firmware fallbacks) ─────────────
MAINS_DELAY_MIN=5
WAN_TIMEOUT_MIN=10
